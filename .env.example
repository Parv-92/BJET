# Environment Variables Example
PROJECT_NAME="Smart Budget API"
DATABASE_URL="sqlite:///./smart_budget.db"
# For PostgreSQL in staging/production:
# DATABASE_URL="postgresql://user:password@localhost:5432/smart_budget"

SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["*"]
